<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/schedule_widget_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/widget_today"
            android:textColor="#2c1a0e" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/schedule_widget_add" android:gravity="center"
            android:text="+" android:textColor="#faf6ef" android:textSize="24sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_schedule_hint"
        android:textColor="#5a3e2b" android:textSize="13sp" />
</LinearLayout>
